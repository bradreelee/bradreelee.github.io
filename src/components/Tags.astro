---
// Hashtag-style labels for the themes a post is about.
interface Props {
  tags: string[];
  class?: string;
}
const { tags, class: cls } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-1.5', cls]}>
      {tags.map((tag) => (
        <li class="whitespace-nowrap rounded-md bg-stone-200/70 px-2 py-0.5 text-xs font-medium text-stone-600 dark:bg-stone-800 dark:text-stone-300">
          #{tag}
        </li>
      ))}
    </ul>
  )
}
