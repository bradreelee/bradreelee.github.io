---
import { getTimeline, period, slugOf, ym } from '../lib/line';
import { ui, localize, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const items = await getTimeline(lang);
---

<ol class="relative border-l border-stone-300 dark:border-stone-700">
  {
    items.map(({ org, projects }) => {
      const { organization, title, type, start, end, summary, link } = org.data;
      return (
        <li id={`org-${slugOf(org)}`} class="mb-12 ml-6 scroll-mt-8 last:mb-0">
          <span class="absolute -left-[5px] mt-2 h-2.5 w-2.5 rounded-full bg-stone-400 ring-4 ring-stone-50 dark:bg-stone-500 dark:ring-stone-950" />
          <p class="text-sm tabular-nums text-stone-500">
            {period(lang, start, end)}
            <span class="ml-2 rounded bg-stone-200 px-1.5 py-0.5 text-xs text-stone-600 dark:bg-stone-800 dark:text-stone-400">
              {t.type[type]}
            </span>
          </p>
          <h3 class="mt-1 text-lg font-semibold text-stone-900 dark:text-stone-100">
            {link ? (
              <a href={link} class="hover:underline" target="_blank" rel="noopener">
                {organization}
              </a>
            ) : (
              organization
            )}
            <span class="font-normal text-stone-500"> · {title}</span>
          </h3>
          {summary && <p class="mt-1">{summary}</p>}

          {projects.length > 0 && (
            <ul class="mt-4 space-y-3 border-l border-dashed border-stone-300 pl-4 dark:border-stone-700" aria-label={t.orgProjectsAria(organization)}>
              {projects.map((p) => (
                <li>
                  <a href={localize(lang, `/projects/${slugOf(p)}/`)} class="group block">
                    <span class="font-medium text-stone-900 group-hover:underline dark:text-stone-100">{p.data.title}</span>
                    <span class="ml-2 text-xs tabular-nums text-stone-500">{period(lang, p.data.start, p.data.end)}</span>                  </a>
                </li>
              ))}
            </ul>
          )}
          {org.data.honors.length > 0 && (
            <ul class="mt-4 space-y-3 border-l border-dashed border-stone-300 pl-4 dark:border-stone-700">
              {org.data.honors.map((h) => (
                <li>
                  <span class="font-medium text-stone-900 dark:text-stone-100">{h.title}</span>
                  <span class="ml-2 text-xs tabular-nums text-stone-500">{ym(h.date)}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>
