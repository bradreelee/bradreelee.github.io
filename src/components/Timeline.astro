---
import { getCollection, render } from 'astro:content';

const typeLabel = {
  work: '경력',
  education: '학력',
  project: '프로젝트',
  etc: '기타',
} as const;

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;

const entries = (await getCollection('timeline')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

const items = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<ol class="relative border-l border-stone-300 dark:border-stone-700">
  {
    items.map(({ entry, Content }) => {
      const { title, organization, type, start, end, summary, tags, link } = entry.data;
      return (
        <li class="mb-12 ml-6 last:mb-0">
          <span class="absolute -left-[5px] mt-2 h-2.5 w-2.5 rounded-full bg-stone-400 ring-4 ring-stone-50 dark:bg-stone-500 dark:ring-stone-950" />
          <p class="text-sm tabular-nums text-stone-500">
            {fmt(start)} – {end ? fmt(end) : '현재'}
            <span class="ml-2 rounded bg-stone-200 px-1.5 py-0.5 text-xs text-stone-600 dark:bg-stone-800 dark:text-stone-400">
              {typeLabel[type]}
            </span>
          </p>
          <h3 class="mt-1 text-lg font-semibold text-stone-900 dark:text-stone-100">
            {link ? (
              <a href={link} class="hover:underline" target="_blank" rel="noopener">
                {organization}
              </a>
            ) : (
              organization
            )}
            <span class="font-normal text-stone-500"> · {title}</span>
          </h3>
          {summary && <p class="mt-1">{summary}</p>}
          <div class="mt-2 text-stone-600 dark:text-stone-400 [&_li]:mt-1 [&_ul]:list-disc [&_ul]:pl-5">
            <Content />
          </div>
          {tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <li class="rounded-full border border-stone-300 px-2 py-0.5 text-xs dark:border-stone-700">{t}</li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>
