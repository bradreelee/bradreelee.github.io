---
import Layout from '../../../layouts/Layout.astro';
import { getPosts, slugOf, fmtDate } from '../../../lib/line';
import { ui, localize, langParams, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return langParams().map(({ lang, param }) => ({ params: { lang: param }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = await getPosts(lang);
---

<Layout lang={lang} title={t.blog.title} description={t.blog.description}>
  <h1 class="text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-50">{t.blog.title}</h1>
  <p class="mt-3 text-stone-600 dark:text-stone-400">{t.blog.description}</p>

  {
    posts.length === 0 ? (
      <p class="mt-12 text-stone-500">{t.blog.empty}</p>
    ) : (
      <ul class="mt-12 space-y-8">
        {posts.map((p) => (
          <li>
            <a href={localize(lang, `/blog/${slugOf(p)}/`)} class="group block">
              <time class="text-sm tabular-nums text-stone-500" datetime={p.data.pubDate.toISOString()}>
                {fmtDate(lang, p.data.pubDate)}
              </time>
              <span class="mt-1 block text-lg font-semibold text-stone-900 group-hover:underline dark:text-stone-100">{p.data.title}</span>
              <span class="mt-1 block text-stone-600 dark:text-stone-400">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
