---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import LinkCard from '../../../components/LinkCard.astro';
import { getOrgs, getProjects, getPosts, period, slugOf, slugsIn, type Project } from '../../../lib/line';
import { ui, localize, otherLang, langParams, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const { lang, param } of langParams()) {
    for (const project of await getProjects(lang)) {
      paths.push({ params: { lang: param, slug: slugOf(project) }, props: { lang, project } });
    }
  }
  return paths;
}

const { lang, project } = Astro.props as { lang: Lang; project: Project };
const t = ui[lang];
const slug = slugOf(project);
const org = (await getOrgs(lang)).find((o) => slugOf(o) === project.data.org);
if (!org) throw new Error(`Unknown org "${project.data.org}" in project ${project.id}`);
const { Content } = await render(project);
const posts = (await getPosts(lang)).filter((p) => p.data.project === slug);
const translated = (await slugsIn('projects', otherLang(lang))).has(slug);
---

<Layout
  lang={lang}
  title={project.data.title}
  description={project.data.summary}
  alternate={translated ? `/projects/${slug}/` : '/projects/'}
>
  <article>
    <p class="text-sm text-stone-500">
      <a href={localize(lang, `/#org-${slugOf(org)}`)} class="hover:underline">{org.data.organization}</a>
      <span class="ml-2 tabular-nums">{period(lang, project.data.start, project.data.end)}</span>
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl dark:text-stone-50">{project.data.title}</h1>
    <p class="mt-4 text-lg leading-relaxed">{project.data.summary}</p>
    {
      project.data.stack.length > 0 && (
        <div class="mt-5 flex flex-wrap items-center gap-1.5">
          {project.data.stack.map((s) => (
            <span class="rounded-full border border-stone-300 px-2 py-0.5 text-xs dark:border-stone-700">{s}</span>
          ))}
        </div>
      )
    }

    {
      project.data.links.length > 0 && (
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {project.data.links.map((l) => <LinkCard href={l.href} label={l.label} />)}
        </div>
      )
    }

    {
      project.data.images.length > 0 && (
        <div class="mt-10 grid grid-cols-2 gap-3">
          {project.data.images.map((img, i) => (
            <img
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class:list={[
                'w-full rounded-lg border border-stone-200 bg-stone-100 dark:border-stone-800 dark:bg-stone-900',
                i === 0 && 'col-span-2',
              ]}
            />
          ))}
        </div>
      )
    }

    <div class="prose prose-stone mt-10 max-w-none dark:prose-invert prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </div>

    {
      posts.length > 0 && (
        <section class="mt-14 border-t border-stone-200 pt-6 dark:border-stone-800" aria-labelledby="related">
          <h2 id="related" class="text-sm font-semibold text-stone-500">{t.relatedPosts}</h2>
          <ul class="mt-3 space-y-1">
            {posts.map((p) => (
              <li>
                <a href={localize(lang, `/blog/${slugOf(p)}/`)} class="underline underline-offset-4">{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>
