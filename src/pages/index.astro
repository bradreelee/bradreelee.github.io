---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/profile';
---

<Layout title={`${profile.name} | ${profile.role}`} description={profile.headline}>
  <main class="mx-auto max-w-2xl px-5 py-20 sm:py-28">
    <header>
      <p class="text-sm font-medium text-stone-500">{profile.role}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl dark:text-stone-50">
        {profile.name}
      </h1>
      <p class="mt-5 text-lg leading-relaxed">{profile.headline}</p>
      <nav class="mt-6 flex flex-wrap gap-4 text-sm">
        {
          profile.links.map((l) => (
            <a href={l.href} class="underline decoration-stone-300 underline-offset-4 hover:decoration-stone-800 dark:hover:decoration-stone-200" target="_blank" rel="noopener">
              {l.label}
            </a>
          ))
        }
      </nav>
    </header>

    <section class="mt-20" aria-labelledby="about">
      <h2 id="about" class="text-sm font-semibold uppercase tracking-widest text-stone-500">About</h2>
      <div class="mt-4 space-y-4 leading-relaxed">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
      <ul class="mt-6 flex flex-wrap gap-2">
        {profile.skills.map((s) => <li class="rounded-md bg-stone-200 px-2.5 py-1 text-sm dark:bg-stone-800">{s}</li>)}
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="timeline">
      <h2 id="timeline" class="mb-8 text-sm font-semibold uppercase tracking-widest text-stone-500">Timeline</h2>
      <Timeline />
    </section>

    <footer class="mt-24 text-sm text-stone-500">
      © {new Date().getFullYear()} {profile.name}
    </footer>
  </main>
</Layout>
