---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/profile';
import { getPosts } from '../lib/line';

const posts = (await getPosts()).slice(0, 3);
const links = [{ label: 'Email', href: `mailto:${profile.email}` }, ...profile.links];
---

<Layout>
  <header>
    <p class="text-sm font-medium text-stone-500">{profile.role}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl dark:text-stone-50">
      {profile.name}
    </h1>
    <p class="mt-5 text-lg leading-relaxed">{profile.headline}</p>
    <nav class="mt-6 flex flex-wrap gap-4 text-sm" aria-label="연락처">
      {
        links.map((l) => (
          <a href={l.href} class="underline decoration-stone-300 underline-offset-4 hover:decoration-stone-800 dark:hover:decoration-stone-200" target="_blank" rel="noopener">
            {l.label}
          </a>
        ))
      }
    </nav>
  </header>

  <section class="mt-20" aria-labelledby="about">
    <h2 id="about" class="text-sm font-semibold uppercase tracking-widest text-stone-500">About</h2>
    <div class="mt-4 space-y-4 leading-relaxed">
      {profile.about.map((p) => <p>{p}</p>)}
    </div>
    <ul class="mt-6 flex flex-wrap gap-2">
      {profile.skills.map((s) => <li class="rounded-md bg-stone-200 px-2.5 py-1 text-sm dark:bg-stone-800">{s}</li>)}
    </ul>
  </section>

  <section class="mt-20" aria-labelledby="timeline">
    <h2 id="timeline" class="mb-8 text-sm font-semibold uppercase tracking-widest text-stone-500">Timeline</h2>
    <Timeline />
  </section>

  {
    posts.length > 0 && (
      <section class="mt-20" aria-labelledby="posts">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 id="posts" class="text-sm font-semibold uppercase tracking-widest text-stone-500">Writing</h2>
          <a href="/blog/" class="text-sm text-stone-500 underline-offset-4 hover:underline">전체 글</a>
        </div>
        <ul class="space-y-6">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`} class="group block">
                <time class="text-sm tabular-nums text-stone-500" datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('ko-KR')}
                </time>
                <span class="mt-1 block font-semibold text-stone-900 group-hover:underline dark:text-stone-100">{p.data.title}</span>
                <span class="mt-1 block text-sm text-stone-600 dark:text-stone-400">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
