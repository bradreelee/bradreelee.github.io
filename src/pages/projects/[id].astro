---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { period, getPosts } from '../../lib/line';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const org = await getEntry(project.data.org);
if (!org) throw new Error(`Unknown org "${project.data.org.id}" in project ${project.id}`);
const { Content } = await render(project);
const posts = (await getPosts()).filter((p) => p.data.project?.id === project.id);
---

<Layout title={project.data.title} description={project.data.summary}>
  <article>
    <p class="text-sm text-stone-500">
      <a href={`/#org-${org.id}`} class="hover:underline">{org.data.organization}</a>
      <span class="ml-2 tabular-nums">{period(project.data.start, project.data.end)}</span>
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl dark:text-stone-50">{project.data.title}</h1>
    <p class="mt-4 text-lg leading-relaxed">{project.data.summary}</p>
    {
      (project.data.stack.length > 0 || project.data.links.length > 0) && (
        <div class="mt-5 flex flex-wrap items-center gap-1.5 text-sm">
          {project.data.stack.map((s) => (
            <span class="rounded-full border border-stone-300 px-2 py-0.5 text-xs dark:border-stone-700">{s}</span>
          ))}
          {project.data.links.map((l) => (
            <a href={l.href} class="ml-2 underline underline-offset-4" rel="noopener">{l.label}</a>
          ))}
        </div>
      )
    }

    <div class="prose prose-stone mt-10 max-w-none dark:prose-invert">
      <Content />
    </div>

    {
      posts.length > 0 && (
        <section class="mt-14 border-t border-stone-200 pt-6 dark:border-stone-800" aria-labelledby="related">
          <h2 id="related" class="text-sm font-semibold text-stone-500">관련 글</h2>
          <ul class="mt-3 space-y-1">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`} class="underline underline-offset-4">{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>
