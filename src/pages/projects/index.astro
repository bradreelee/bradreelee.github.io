---
import Layout from '../../layouts/Layout.astro';
import { getTimeline, period } from '../../lib/line';

const groups = (await getTimeline()).filter((g) => g.projects.length > 0);
---

<Layout title="프로젝트" description="조직별로 정리한 프로젝트 목록입니다.">
  <h1 class="text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-50">프로젝트</h1>

  <div class="mt-12 space-y-14">
    {
      groups.map(({ org, projects }) => (
        <section aria-labelledby={`g-${org.id}`}>
          <h2 id={`g-${org.id}`} class="text-sm font-semibold text-stone-500">
            <a href={`/#org-${org.id}`} class="hover:underline">{org.data.organization}</a>
            <span class="ml-2 font-normal tabular-nums">{period(org.data.start, org.data.end)}</span>
          </h2>
          <ul class="mt-4 space-y-6">
            {projects.map((p) => (
              <li>
                <a href={`/projects/${p.id}/`} class="group block">
                  <span class="text-lg font-semibold text-stone-900 group-hover:underline dark:text-stone-100">{p.data.title}</span>
                  <span class="mt-1 block text-stone-600 dark:text-stone-400">{p.data.summary}</span>
                </a>
                {p.data.stack.length > 0 && (
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {p.data.stack.map((s) => (
                      <li class="rounded-full border border-stone-300 px-2 py-0.5 text-xs dark:border-stone-700">{s}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
