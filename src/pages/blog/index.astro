---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/line';

const posts = await getPosts();
---

<Layout title="글" description="기술 문제를 어떻게 분석하고 해결했는지 기록합니다.">
  <h1 class="text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-50">글</h1>
  <p class="mt-3 text-stone-600 dark:text-stone-400">기술 문제를 어떻게 분석하고 해결했는지 기록합니다.</p>

  {
    posts.length === 0 ? (
      <p class="mt-12 text-stone-500">아직 공개한 글이 없습니다.</p>
    ) : (
      <ul class="mt-12 space-y-8">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="group block">
              <time class="text-sm tabular-nums text-stone-500" datetime={p.data.pubDate.toISOString()}>
                {p.data.pubDate.toLocaleDateString('ko-KR')}
              </time>
              <span class="mt-1 block text-lg font-semibold text-stone-900 group-hover:underline dark:text-stone-100">{p.data.title}</span>
              <span class="mt-1 block text-stone-600 dark:text-stone-400">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
